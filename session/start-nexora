#!/usr/bin/env bash
set -uo pipefail

# Nexora OS native Wayland session entry point.
# This launcher is deliberately defensive: optional services may fail without
# tearing down the graphical session, and all fatal startup diagnostics are
# written to a persistent per-user log.

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Nexora
export XDG_SESSION_DESKTOP=nexora
export DESKTOP_SESSION=nexora
export KDE_APPLICATIONS_AS_SCOPE=1
export QT_QPA_PLATFORM=wayland

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nexora"
LOG="$STATE_DIR/native-session.log"
SHELL_BIN="$HOME/.local/bin/nexora-shell"
SUPERVISOR="$HOME/.local/libexec/nexora-shell-supervisor"
mkdir -p "$STATE_DIR"

log() { printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" >>"$LOG"; }

: >"$LOG"
log "===== Nexora OS native session ====="
log "uid=$(id -u) user=$(id -un) HOME=$HOME"
log "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-<unset>}"
log "DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-<unset>}"
log "shell=$SHELL_BIN supervisor=$SUPERVISOR"

# A missing D-Bus session is recoverable. Re-enter once under dbus-run-session
# instead of letting SDDM see an immediate session failure.
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && "${NEXORA_DBUS_REENTERED:-0}" != "1" ]]; then
  log "No D-Bus session address; re-entering under dbus-run-session"
  export NEXORA_DBUS_REENTERED=1
  exec dbus-run-session -- "$0"
fi

# Optional services are explicitly non-fatal. The desktop must remain usable
# even if audio, Tony, voice, context indexing, or a portal is unavailable.
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service >>"$LOG" 2>&1 || true
  systemctl --user start nexora-core.service nexora-context.service >>"$LOG" 2>&1 || true
  systemctl --user start nexora-tony.service nexora-voice.service >>"$LOG" 2>&1 || true
fi

# KWin owns the Wayland display. The supervisor owns the shell lifecycle and
# contains a visible recovery path, so a shell crash no longer bounces a user
# back to SDDM.
if [[ ! -x "$SUPERVISOR" ]]; then
  log "FATAL supervisor missing: $SUPERVISOR"
  if command -v xterm >/dev/null 2>&1; then
    exec /usr/bin/kwin_wayland --xwayland --exit-with-session \
      /usr/bin/xterm -title "Nexora Recovery" -e /bin/sh -lc \
      "echo 'Nexora session supervisor is missing.'; echo 'Log: $LOG'; echo; tail -n 80 '$LOG'; echo; printf 'Press Enter to return to login...'; read _"
  fi
  exit 127
fi

log "Launching KWin -> Nexora shell supervisor"
exec /usr/bin/kwin_wayland --xwayland --exit-with-session "$SUPERVISOR" >>"$LOG" 2>&1
