#!/usr/bin/env bash
set -u

SHELL_BIN="$HOME/.local/bin/nexora-shell"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nexora"
LOG="$STATE_DIR/shell-supervisor.log"
mkdir -p "$STATE_DIR"

child=""
stopping=0
forward_stop() {
  stopping=1
  if [[ -n "$child" ]] && kill -0 "$child" 2>/dev/null; then kill -TERM "$child" 2>/dev/null || true; fi
}
trap forward_stop TERM INT HUP

crashes=0
while true; do
  if [[ ! -x "$SHELL_BIN" ]]; then
    echo "$(date --iso-8601=seconds) FATAL shell missing: $SHELL_BIN" >>"$LOG"
    exit 127
  fi

  started=$(date +%s)
  echo "$(date --iso-8601=seconds) starting nexora-shell" >>"$LOG"
  "$SHELL_BIN" >>"$LOG" 2>&1 &
  child=$!
  wait "$child"
  rc=$?
  child=""
  lived=$(( $(date +%s) - started ))

  if (( stopping )); then
    echo "$(date --iso-8601=seconds) session supervisor stopping" >>"$LOG"
    exit 0
  fi

  # rc=0 is the intentional Nexora logout path.
  if (( rc == 0 )); then
    echo "$(date --iso-8601=seconds) shell exited cleanly" >>"$LOG"
    exit 0
  fi

  # A long healthy run resets the short crash-loop budget.
  if (( lived >= 60 )); then crashes=0; fi
  crashes=$((crashes + 1))
  echo "$(date --iso-8601=seconds) shell crashed rc=$rc lived=${lived}s attempt=$crashes" >>"$LOG"

  if (( crashes >= 3 )); then
    echo "$(date --iso-8601=seconds) crash loop detected; returning to login manager" >>"$LOG"
    exit "$rc"
  fi
  sleep 1
done
