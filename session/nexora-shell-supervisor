#!/usr/bin/env bash
set -uo pipefail

SHELL_BIN="$HOME/.local/bin/nexora-shell"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nexora"
LOG="$STATE_DIR/shell-supervisor.log"
mkdir -p "$STATE_DIR"

# Automated ISO smoke tests boot with nexora.ci-smoke=1 and place the live user
# in the dialout group. Normal users never see this path. The marker lets CI
# prove that SDDM -> KWin -> supervisor -> Nexora Shell remained alive instead
# of merely proving that the kernel booted.
ci_smoke=0
if grep -Fqw 'nexora.ci-smoke=1' /proc/cmdline 2>/dev/null; then
  ci_smoke=1
fi
ci_mark() {
  (( ci_smoke )) || return 0
  local msg="NEXORA_SMOKE:$*"
  printf '%s\n' "$msg" >>"$LOG"
  if [[ -w /dev/ttyS0 ]]; then
    printf '%s\r\n' "$msg" >/dev/ttyS0 2>/dev/null || true
  fi
}

child=""
smoke_probe=""
stopping=0
forward_stop() {
  stopping=1
  if [[ -n "$smoke_probe" ]] && kill -0 "$smoke_probe" 2>/dev/null; then
    kill -TERM "$smoke_probe" 2>/dev/null || true
  fi
  if [[ -n "$child" ]] && kill -0 "$child" 2>/dev/null; then
    kill -TERM "$child" 2>/dev/null || true
  fi
}
trap forward_stop TERM INT HUP

log() { printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" >>"$LOG"; }

runtime_preflight() {
  local failed=0 missing=""

  if [[ ! -x "$SHELL_BIN" ]]; then
    log "PREFLIGHT FAIL shell missing: $SHELL_BIN"
    return 1
  fi

  if command -v ldd >/dev/null 2>&1; then
    missing="$(ldd "$SHELL_BIN" 2>/dev/null | grep -F 'not found' || true)"
    if [[ -n "$missing" ]]; then
      log "PREFLIGHT FAIL unresolved shared libraries:"
      printf '%s\n' "$missing" >>"$LOG"
      failed=1
    fi
  fi

  # Nexora is a Qt 6 Wayland application. With --apt-recommends=false the
  # platform plugin must be an explicit dependency of the image.
  if ! find /usr/lib /lib -type f -path '*/qt6/plugins/platforms/libqwayland*.so' -print -quit 2>/dev/null | grep -q .; then
    log "PREFLIGHT FAIL Qt 6 Wayland platform plugin is missing"
    failed=1
  fi

  return "$failed"
}

show_recovery() {
  local reason="$1"
  log "RECOVERY $reason"

  # Never throw the user back into a login loop for a shell crash. KWin stays
  # alive and a tiny XTerm recovery window explains what happened. Closing it
  # causes an automatic retry.
  if command -v xterm >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
    /usr/bin/xterm -title "Nexora Recovery" -geometry 104x28 -e /bin/sh -lc \
      "printf '\nNexora recovered from a desktop startup failure.\n\n'; \
       printf 'The session is still running; no logout was forced.\n'; \
       printf 'Recent diagnostics:\n\n'; \
       tail -n 100 '$LOG' 2>/dev/null || true; \
       printf '\nPress Enter to retry the Nexora desktop...'; read _" || true
  else
    # Extremely small fallback for a broken Xwayland/xterm path: keep the
    # session alive and retry rather than returning to SDDM.
    sleep 5
  fi
}

crashes=0
while true; do
  if ! runtime_preflight; then
    ci_mark "PREFLIGHT_FAIL"
    show_recovery "runtime preflight failed"
    crashes=0
    continue
  fi

  started=$(date +%s)
  log "starting nexora-shell"
  "$SHELL_BIN" >>"$LOG" 2>&1 &
  child=$!

  # A shell that survives the initial 20-second startup window is considered
  # ready for the automated live-image smoke test. The host then terminates the
  # disposable QEMU guest; this has no effect during normal boots.
  smoke_probe=""
  if (( ci_smoke )); then
    (
      sleep 20
      if kill -0 "$child" 2>/dev/null; then
        ci_mark "SESSION_READY"
      fi
    ) &
    smoke_probe=$!
  fi

  wait "$child"
  rc=$?
  if [[ -n "$smoke_probe" ]] && kill -0 "$smoke_probe" 2>/dev/null; then
    kill -TERM "$smoke_probe" 2>/dev/null || true
    wait "$smoke_probe" 2>/dev/null || true
  fi
  smoke_probe=""
  child=""
  lived=$(( $(date +%s) - started ))

  if (( stopping )); then
    log "session supervisor stopping"
    exit 0
  fi

  # rc=0 is the intentional Nexora logout path requested by the user. During
  # CI it is an early-session failure because nobody requested a logout.
  if (( rc == 0 )); then
    if (( ci_smoke )); then
      ci_mark "SESSION_EXITED_EARLY lived=${lived}s"
      sleep 5
      continue
    fi
    log "shell exited cleanly; ending session"
    exit 0
  fi

  ci_mark "SESSION_CRASH rc=$rc lived=${lived}s"
  if (( lived >= 60 )); then crashes=0; fi
  crashes=$((crashes + 1))
  log "shell crashed rc=$rc lived=${lived}s attempt=$crashes"

  if (( crashes >= 3 )); then
    show_recovery "desktop crash loop detected"
    crashes=0
  else
    sleep 1
  fi
done
