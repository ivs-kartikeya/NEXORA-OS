[Unit]
Description=Nexora Core - deterministic OS service layer
After=dbus.service pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/bin/nexora-core
Restart=on-failure
RestartSec=1
Nice=0
CPUAccounting=true
MemoryAccounting=true

[Install]
WantedBy=default.target
