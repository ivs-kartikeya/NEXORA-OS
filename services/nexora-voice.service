[Unit]
Description=Nexora OS local voice service
Wants=pipewire.service pipewire-pulse.service wireplumber.service
After=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/nexora/services/nexora-voiced.py
Restart=on-failure
RestartSec=1
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.local/share/nexora %h/.local/state/nexora /tmp

[Install]
WantedBy=default.target
